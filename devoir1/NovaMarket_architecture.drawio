=#0b4f96;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="630"/></Array></mxGeometry></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0b6bcb;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;fontColor=#0b4f96;labelBackgroundColor=#ffffff;exitX=1;exitY=0.27;entryX=0;entryY=0.5;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="mesures.csv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0b6bcb;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;fontColor=#0b4f96;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;DOCKER · service fournisseur (profil ingestion)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#1f6feb;strokeWidth=2;fillColor=#f3f8ff;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#1f4e9e;" vertex="1" parent="1"><mxGeometry x="35" y="810" width="340" height="175" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;API fournisseur simulée — ingestion/api/server.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Python 3.12 stdlib : http.server (ThreadingHTTPServer)&lt;br&gt;GET /offers?page=1..6&amp;scenario=clean|atelier|panne&amp;run=&lt;br&gt;GET /health · fautes déterministes : 429, 5xx, JSON invalide&lt;br&gt;latence API_LATENCY_SECONDS = 0,12 s · données fictives&lt;br&gt;:8080 → 127.0.0.1:18080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="845" width="320" height="130" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Référentiel produits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;s2/donnees/products.csv (même fichier que S2)&lt;br&gt;monté en lecture seule dans collecteur&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="1000" width="320" height="60" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Lots S4 de démonstration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;transformation/exemple_lots/*.jsonl&lt;br&gt;(jour_precedent, correction_prix, defectueux)&lt;br&gt;transformation/secours/offres.jsonl&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="1075" width="320" height="75" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;DOCKER · service collecteur (profil ingestion)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ou venv local Python 3.12 · tests : python -m unittest&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#1f6feb;strokeWidth=2;fillColor=#f3f8ff;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#1f4e9e;" vertex="1" parent="1"><mxGeometry x="405" y="810" width="430" height="255" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;collecteur.py — collecte asynchrone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;i&gt;&lt;font color=&quot;#7a3e9d&quot;&gt;aiohttp 3.13 · asyncio · hashlib&lt;/font&gt;&lt;/i&gt;&lt;br&gt;page 1 → total_pages, puis pages 2..N en parallèle (sémaphore)&lt;br&gt;réessais : timeout, 429, 5xx, JSON — Retry-After / backoff exp.&lt;br&gt;page manquante ⇒ lot en échec, rien n&#x27;est publié&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="855" width="410" height="90" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;validation.py — contrat de données&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;structure (7 champs, types stricts) puis règles métier :&lt;br&gt;fournisseur ∈ {F01,F02,F03}, EUR, product_id ∈ catalogue, offer_id unique&lt;br&gt;toutes les fautes d&#x27;une offre sont relevées&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="953" width="410" height="72" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;journalisation.py — logs JSONL (logging) + Bilan (compteurs, motifs)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="1030" width="410" height="30" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;DOCKER · service chargeur (profil transfo)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;image collecteur · entrypoint chargement_postgres.py&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#1f6feb;strokeWidth=2;fillColor=#f3f8ff;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#1f4e9e;" vertex="1" parent="1"><mxGeometry x="405" y="1080" width="430" height="170" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;chargement_postgres.py — chargeur S4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;i&gt;&lt;font color=&quot;#7a3e9d&quot;&gt;psycopg 3.3&lt;/font&gt;&lt;/i&gt;&lt;br&gt;UNE transaction + verrou applicatif ; empreinte SHA-256 du lot&lt;br&gt;contrôles ligne : JSON, types, EUR, date, fournisseur connu,&lt;br&gt;produit ∈ nova.products, doublon dans le lot&lt;br&gt;UPSERT (offer_id, observed_on) : insérée / mise à jour / réutilisée&lt;br&gt;erreur ⇒ ROLLBACK, lot tracé « annule » · --essai · --echouer-apres&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="1125" width="410" height="118" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;LOCAL · fichiers hôte ingestion/data/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bind mount ./ingestion → /work/ingestion&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 3;strokeColor=#555555;strokeWidth=2;fillColor=#fafafa;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="870" y="810" width="250" height="300" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;raw/&amp;lt;run&amp;gt;.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;toutes les réponses reçues (même refusées)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="855" width="230" height="50" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;valid/offres.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ offres.manifest.json (run, SHA-256)&lt;br&gt;publication atomique (tmp → rename)&lt;br&gt;valid/runs/&amp;lt;run&amp;gt;.jsonl (historique)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=