<mxfile host="app.diagrams.net" agent="NovaMarket generator" version="24.0.0"><diagram id="novamarket-archi" name="Architecture &amp; flux NovaMarket"><mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="2100" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;NovaMarket — Cartographie de l&#x27;architecture et des flux de données (S1 → S5)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Devoir 1 · Ingénierie des données et pipelines SQL · Mastère 1 IA &amp;amp; Data — Ynov Campus · Groupe : ____________________ · Dépôt : Donnees_pipelines_SQL (novamarket/)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="2200" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;BRANCHE 1 · Transactionnel NovaMarket (S1 → S2)&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#555&quot;&gt;— séquentielle : run_all.sh (S1) puis run_s2.sh (S2) ; S2 s&#x27;appuie sur les schémas reception / rejets / nova créés en S1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#c8c8c8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="2280" height="420" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;BRANCHE 2 · Benchmark S3 (10 M lignes)&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#555&quot;&gt;— &lt;b&gt;INDÉPENDANTE&lt;/b&gt; : données générées par generate_series, schéma benchmark isolé ; ne lit aucune table NovaMarket&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#c8c8c8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2280" height="220" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;BRANCHE 3 · Offres fournisseurs (S3 ingestion → S4 chargement + dbt)&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#555&quot;&gt;— collecte indépendante de PostgreSQL ; le chargement et dbt &lt;b&gt;dépendent de la branche 1&lt;/b&gt; (nova.products, nova.orders / order_items)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#c8c8c8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="2280" height="490" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;BRANCHE 4 · Volumétrie S5 (Hugging Face → contrôle qualité → Spark → Hub)&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#555&quot;&gt;— &lt;b&gt;INDÉPENDANTE&lt;/b&gt; de PostgreSQL et des branches 1 à 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#c8c8c8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="1270" width="2280" height="460" as="geometry"/></mxCell><mxCell id="c6" value="① SOURCES" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="330" height="30" as="geometry"/></mxCell><mxCell id="c7" value="② INGESTION &amp; VALIDATION" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="410" y="72" width="420" height="30" as="geometry"/></mxCell><mxCell id="c8" value="③ STOCKAGE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="870" y="72" width="560" height="30" as="geometry"/></mxCell><mxCell id="c9" value="④ TRAITEMENTS &amp; TRANSFORMATIONS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1470" y="72" width="430" height="30" as="geometry"/></mxCell><mxCell id="c10" value="⑤ RESTITUTION" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1940" y="72" width="340" height="30" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;DOCKER · service postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;postgres:17.12-bookworm · base novamarket · toujours actif&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#1f6feb;strokeWidth=2;fillColor=#f3f8ff;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#1f4e9e;" vertex="1" parent="1"><mxGeometry x="1155" y="140" width="290" height="1110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;schéma reception&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Zone d&#x27;atterrissage brute (TEXT)&lt;br&gt;customers · orders · order_items&lt;br&gt;payments (document NDJSON) · categories · products&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1165" y="185" width="270" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;schéma rejets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rejets.journal : source, ligne, clé, motif,&lt;br&gt;contenu jsonb (traçabilité des refus)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1165" y="292" width="270" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;schéma nova (modèle typé)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;customers · orders · order_items · payments&lt;br&gt;categories (hiérarchie) · products&lt;br&gt;PK / FK / CHECK&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1165" y="375" width="270" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;schéma benchmark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;benchmark_sales : 10 000 000 lignes&lt;br&gt;campaign_assignments&lt;br&gt;index benchmark_sales_store_id_idx (S3)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1165" y="580" width="270" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;schéma fournisseur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fournisseurs (référentiel F01–F03)&lt;br&gt;offres — PK (offer_id, observed_on)&lt;br&gt;lots (compteurs, statut) · lot_lignes (action par ligne)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1165" y="820" width="270" height="105" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;schémas dbt_dev_*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dbt_dev_staging (vues) · dbt_dev_intermediate (vues)&lt;br&gt;dbt_dev_marts.mart_offres_par_produit (table)&lt;br&gt;← matérialisés par dbt (CREATE VIEW / TABLE, TCP 5432)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1165" y="945" width="270" height="95" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Infrastructure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;volume nommé &lt;b&gt;postgres_data&lt;/b&gt; → /var/lib/postgresql/data&lt;br&gt;bind ./s1 → /s1 (lecture seule)&lt;br&gt;port 127.0.0.1:15432 → 5432 · 2 CPU / 2 Go&lt;br&gt;healthcheck pg_isready · réseau Compose (hôte « postgres »)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1165" y="1145" width="270" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;LOCAL · dépôt Git (fichiers sources)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 3;strokeColor=#555555;strokeWidth=2;fillColor=#fafafa;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="140" width="340" height="380" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;s1/donnees/*.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;customers.csv · orders.csv · order_items.csv&lt;br&gt;CSV UTF-8 avec anomalies volontaires&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="170" width="320" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;s1/donnees/payments.ndjson&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 document JSON par ligne (lignes invalides incluses)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="250" width="320" height="55" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;s2/donnees/categories.csv · products.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;catalogue S2 (brut, non modifié ;&lt;br&gt;doublon exact product_id = 3)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="45" y="315" width="320" height="65" as="geometry"/></mxCell><mxCell id="c23" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;• s1/ monté en lecture seule sur /s1 du conteneur postgres&lt;br&gt;• s2/donnees copié par &lt;i&gt;docker compose cp&lt;/i&gt; → /tmp/novamarket-s2&lt;br&gt;• s1/exemple/ (ateliers culturels) : exemple 3FN isolé (06_normalisation)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="390" width="320" height="60" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;DOCKER · exécuté dans postgres via psql&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lancé depuis l&#x27;hôte : docker compose exec -T postgres psql -v ON_ERROR_STOP=1&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#1f6feb;strokeWidth=2;fillColor=#f3f8ff;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#1f4e9e;" vertex="1" parent="1"><mxGeometry x="405" y="140" width="430" height="380" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Import brut (\copy)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;02_import.sql (S1) · 10_catalogue.sql (S2)&lt;br&gt;fichiers → reception.* en TEXT, sans transformation&lt;br&gt;payments.ndjson lu ligne par ligne (document)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="185" width="410" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Typage, contrôles et rejets motivés&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;02_import · 03_controles · 10/11_controles_catalogue&lt;br&gt;pg_input_is_valid(), casts, jsonb -&gt;&gt;, unicité, FK, dates, montants&lt;br&gt;valides → nova.* · invalides → rejets.journal (motif + contenu)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="280" width="410" height="95" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Orchestration (LOCAL · bash)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;s1/sql/run_all.sh : 00_connexion → 06_normalisation&lt;br&gt;s2/sql/run_s2.sh : 10_catalogue → 15_hierarchie (| tee résultats)&lt;br&gt;run_all.sh recrée les schémas S1 (DROP … CASCADE) ⇒ relancer S2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="415" y="395" width="410" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Indicateurs &amp; anomalies S1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;04_indicateurs.sql : CA, paniers, statuts&lt;br&gt;05_anomalies.sql : incohérences commandes / paiements&lt;br&gt;06_normalisation.sql : exemple de passage en 3FN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1475" y="170" width="420" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;SQL avancé S2 (catalogue)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;12_classements : fonctions de fenêtre (classements)&lt;br&gt;13_evolution : évolutions temporelles&lt;br&gt;14_segmentation : CTE, segmentation&lt;br&gt;15_hierarchie : CTE récursive sur categories&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1475" y="280" width="420" height="110" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Sortie psql S1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;contrôles, indicateurs et anomalies affichés&lt;br&gt;→ SOLUTION_S1.md&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1945" y="170" width="330" height="70" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;s2/resultats/10…15_*.txt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sorties psql de chaque script (tee)&lt;br&gt;→ SOLUTION_S2.md · REFERENCE_SQL.md&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;vertical