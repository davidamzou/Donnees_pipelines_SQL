s · stg_nova__categories · stg_nova__order_lines&lt;br&gt;lit source(&#x27;fournisseur&#x27;, …) et source(&#x27;nova&#x27;, …) : renommage, typage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1475" y="870" width="420" height="80" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;intermediate — vues (dbt_dev_intermediate)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;int_offres__enrichies (offres × produits × fournisseurs)&lt;br&gt;int_offres__derniere_observation (dernière offre par produit)&lt;br&gt;int_ventes__par_produit (agrégat ventes S1/S2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1475" y="965" width="420" height="80" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;marts — table (dbt_dev_marts)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mart_offres_par_produit : offres + ventes par produit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1475" y="1060" width="420" height="45" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;Tests — dbt build (PASS = 41)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;génériques : unique, not_null, relationships, accepted_values&lt;br&gt;singuliers : grain unique, sans multiplication, CA réf. S2,&lt;br&gt;volumes, valeurs plausibles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=